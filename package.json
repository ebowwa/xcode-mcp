{
  "name": "@ebowwa/mcp-xcode",
  "version": "1.0.1",
  "description": "Xcode MCP server - build, test, run, and manage simulators from Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xcode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && chmod +x dist/index.js",
    "dev": "bun run src/index.ts",
    "watch": "bun build src/index.ts --outdir dist --target node --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "xcode",
    "xcodebuild",
    "simulator",
    "ios",
    "macos",
    "claude",
    "apple"
  ],
  "author": "ebowwa",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "ownership": {
    "domain": "mcp",
    "responsibilities": [
      "xcode-mcp",
      "ios-development",
      "simulator-management",
      "xcodebuild-automation"
    ]
  }
}
